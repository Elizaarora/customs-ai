# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Signs the login session cookie. Generate your own with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-real-32-byte-secret"

# Gemini API key for document extraction — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="replace-with-a-real-gemini-api-key"

# Fixes a bug in this Next.js version where the action-encryption key the
# framework auto-generates sometimes comes back empty. Generate your own with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-a-real-32-byte-secret"

# File storage driver: "disk" (default, local dev) or "supabase" (production).
STORAGE_DRIVER="disk"

# Required only when STORAGE_DRIVER=supabase. Project URL and a service-role
# key (Project Settings -> API) — the service-role key bypasses row-level
# security, so it must stay server-side only, never exposed to the client.
SUPABASE_URL="replace-with-your-supabase-project-url"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"
SUPABASE_STORAGE_BUCKET="replace-with-your-bucket-name"
